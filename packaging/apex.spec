# SPDX-License-Identifier: GPL-3.0-or-later
#
# Built by `make rpm` from git HEAD, with two macros:
#   commitdate   UTC date of the HEAD commit, YYYYMMDD
#   shortcommit  first 12 hex digits of the HEAD commit
# The installed layout is the Makefile's (`make install`).
#
# Not vendored: %%build fetches the crates pinned by Cargo.lock, in a fedora:45
# container with network access, never in mock or Koji. Vendoring becomes necessary
# only if the build moves to COPR or an offline builder.

# Fedora does not package cargo-auditable, so it cannot be a BuildRequires: rpms.sh
# build installs it into /usr/local/bin first. `--without auditable` is for local
# builds only.
%bcond auditable 1
# %%check validates the D-Bus, polkit and systemd data files (make check-data). Rust
# unit tests run in ci.yml; repeating them here would recompile the whole tree.
%bcond check 1
# This RPM only feeds the image compose and is never published, so a -debuginfo RPM
# would have nowhere to be fetched from. brp-strip keeps the symbol table, so panics
# still print symbolised backtraces. To analyse a core dump, rebuild the same commit
# with `--with debuginfo`; the build-id then matches the shipped binary.
%bcond debuginfo 0

%if %{without debuginfo}
%global debug_package %{nil}
%global rustflags_debuginfo 0
%endif

# Local builds without the macros still work; they get the lowest possible Release.
%{!?commitdate:%global commitdate 0}
%{!?shortcommit:%global shortcommit unknown}

Name:           apex
Version:        0.1.0
Release:        0.%{commitdate}.git%{shortcommit}%{?dist}
Summary:        Apex update service, boot assessment and command-line tool

# Generated by `python3 packaging/licenses.py`; ci.yml and rpms.sh build check it.
License:        Apache-2.0 AND GPL-3.0-or-later AND MIT AND Unicode-3.0 AND (Apache-2.0 OR Apache-2.0 WITH LLVM-exception OR MIT) AND (Apache-2.0 OR MIT) AND (MIT OR Unlicense)
URL:            https://github.com/SekiroKenjii/apex-fedora
# Produced by `make rpm`: git archive --prefix=apex-%%{version}/ HEAD
Source0:        %{name}-%{version}.tar.gz

# One machine, one architecture (ASUS M7400QC, Zen 3).
ExclusiveArch:  x86_64

BuildRequires:  cargo >= 1.93
BuildRequires:  rust >= 1.93
BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  systemd-rpm-macros
# %%build_rustflags (Fedora's RUSTFLAGS) and %%cargo_license for LICENSE.dependencies.
BuildRequires:  cargo-rpm-macros >= 26
%if %{with check}
BuildRequires:  /usr/bin/xmllint
BuildRequires:  /usr/bin/systemd-analyze
%endif

# apex-updated is the only caller of bootc (fork/exec) and reads the staged
# deployment's manifest with `ostree cat`.
Requires:       bootc
Requires:       ostree
# /boot is read-only on bootc systems, so each grub2-editenv write runs as `unshare
# --mount --propagation private` + `mount -o remount,rw /boot` + grub2-editenv.
Requires:       grub2-tools-minimal
Requires:       /usr/bin/unshare
Requires:       /usr/bin/mount
# Owns /usr/lib/bootupd/grub2-static/configs.d, where the boot-counter snippet goes.
Requires:       bootupd
# The system bus (dbus pulls in dbus-broker) and the directories of our bus files.
Requires:       dbus
Requires:       dbus-common
# Authority for the io.github.sekirokenjii.apex.update.* actions; owns actions/.
Requires:       polkit
Requires:       systemd
%{?systemd_requires}

%description
Apex is a personal bootc-based Fedora image for one laptop. This package holds its own
system components:

- apex-updated: the system bus service io.github.sekirokenjii.Apex.Update1, the only
  process that runs bootc. It checks, downloads and stages signed updates, and applies
  them only when the user asks.
- apex-boot-assess: health checks after boot and the counted, automatic rollback of an
  update that does not come up.
- apexctl: the command-line client, and the build and hardware tools used by the image
  build.

%prep
%autosetup -n %{name}-%{version}

%build
# %%build already exported Fedora's RUSTFLAGS (%%build_rustflags), CFLAGS and LDFLAGS.
# CARGO_HOME inside the build tree keeps crates out of $HOME and lets the offline
# %%cargo_license below read the same registry.
export CARGO_HOME="$PWD/.cargo"
export CARGO_BUILD_JOBS=%{_smp_build_ncpus}
cargo fetch --locked
%make_build build AUDITABLE=%{?with_auditable:yes}%{!?with_auditable:no}
%{cargo_license_summary}
%{cargo_license} > LICENSE.dependencies

%install
%make_install PREFIX=%{_prefix}

%if %{with check}
%check
%make_build check-data
%endif

# No %%tmpfiles_create: this package is installed while an image is composed, where
# /var is not the target system's /var. systemd-tmpfiles-setup creates /var/lib/apex
# at boot from %%{_tmpfilesdir}/apex.conf.

%post
%systemd_post apex-updated.service apex-update-auto.service apex-update-auto.timer apex-boot-assess.service

%preun
%systemd_preun apex-updated.service apex-update-auto.service apex-update-auto.timer apex-boot-assess.service

%postun
# No restart for the services: apex-updated is D-Bus activated and exits when idle (a
# restart could kill a running bootc operation; the next activation runs the new
# binary), and the other two are oneshots that a restart would run again.
%systemd_postun apex-updated.service apex-update-auto.service apex-boot-assess.service
%systemd_postun_with_restart apex-update-auto.timer

%files
%license LICENSE
%license LICENSE.dependencies
%doc README.md
%{_bindir}/apexctl
%dir %{_libexecdir}/apex
%{_libexecdir}/apex/apex-updated
%{_libexecdir}/apex/apex-boot-assess
%{_datadir}/dbus-1/interfaces/io.github.sekirokenjii.Apex.Update1.xml
%{_datadir}/dbus-1/system-services/io.github.sekirokenjii.Apex.Update1.service
%{_datadir}/dbus-1/system.d/io.github.sekirokenjii.Apex.Update1.conf
%{_datadir}/polkit-1/actions/io.github.sekirokenjii.apex.update.policy
%{_unitdir}/apex-updated.service
%{_unitdir}/apex-update-auto.service
%{_unitdir}/apex-update-auto.timer
%{_unitdir}/apex-boot-assess.service
# systemd owns neither drop-in directory, so the package owns both.
%dir %{_unitdir}/emergency.service.d
%{_unitdir}/emergency.service.d/50-apex-bootcount.conf
%dir %{_unitdir}/rescue.service.d
%{_unitdir}/rescue.service.d/50-apex-bootcount.conf
%{_tmpfilesdir}/apex.conf
%{_prefix}/lib/bootupd/grub2-static/configs.d/08_apex-bootcount.cfg

