# HDA patch firmware for the Realtek ALC294 of the M7400QC (ADR 0004).
# Generated by apexctl profile render from hardware/m7400qc/profile.toml. Do not edit.
# Installed as /usr/lib/firmware/apex/alc294-m7400qc.fw; apex-audio.conf loads it.
# The kernel replays the [verb] lines at probe and on every runtime and system resume.
# Measured on 2026-09-25, BIOS M7400QC.311.
# Kernel during the measurement: 7.0.0-31-generic.
[codec]
0x10ec0294 0x10431ab2 0

[verb]
# COEF 0x40: 0x8800 after cold boot and after Windows; not written.
# COEF 0x0f: restore the cold-boot value 0x7770 (after Windows: 0x7774).
0x20 0x500 0x000f
0x20 0x400 0x7770
# COEF 0x1b: cold boot 0x4a4b, clear 0x0000, set 0x0400 -> 0x4e4b.
0x20 0x500 0x001b
0x20 0x400 0x4e4b
