---
source: crates/apexctl/tests/render_golden.rs
expression: "file(&rendered, \"apex-audio.conf\")"
---
# Generated by apexctl profile render from hardware/m7400qc/profile.toml. Do not edit.
# Loads the ALC294 HDA patch firmware (ADR 0004). snd-hda-intel assigns patch=
# slots in controller probe order, not by PCI address, so every slot names the same
# file; its [codec] line makes the kernel apply it to the ALC294 only.
options snd-hda-intel patch=apex/alc294-m7400qc.fw,apex/alc294-m7400qc.fw,apex/alc294-m7400qc.fw,apex/alc294-m7400qc.fw
