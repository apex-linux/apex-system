#
# Enabled by 80-apex.preset through `systemctl --user --global preset-all` in the image.
[Unit]
Description=Apex session agent: window radius, terminal caret, the crash-guard offer, Updates Ready and the battery refresh rate
Documentation=https://github.com/apex-linux/apex-system/blob/main/docs/ARCHITECTURE.md
PartOf=graphical-session.target
After=graphical-session.target
# Neither system users nor the greeter have anything to set. GDM 51's greeter is a dynamic user,
# not a system one: only its session class, which gnome-session uploads, tells it apart.
ConditionUser=!@system
ConditionEnvironment=XDG_SESSION_CLASS=user
# Without HOME or a session bus every start fails the same way: give up after three.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
ExecStart=/usr/libexec/apex/apex-session-agent
# Where apex-shell-safe.service leaves the marker (its StateDirectory=apex).
Environment=APEX_SHELL_GUARD_MARKER=%S/apex/shell-guard-tripped
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
