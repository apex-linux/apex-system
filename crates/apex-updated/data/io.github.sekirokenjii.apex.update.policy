<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- auth_admin, never auth_admin_keep: one prompt in a shared process such as gnome-shell
     must not authorize its later calls. -->
<policyconfig>
  <vendor>Apex</vendor>
  <vendor_url>https://github.com/SekiroKenjii/apex-fedora</vendor_url>
  <icon_name>system-software-update</icon_name>

  <action id="io.github.sekirokenjii.apex.update.check">
    <description>Check for system updates</description>
    <message>Authentication is required to check for system updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.sekirokenjii.apex.update.download">
    <description>Download system updates</description>
    <message>Authentication is required to download system updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.sekirokenjii.apex.update.apply">
    <description>Install a downloaded system update at the next restart</description>
    <message>Authentication is required to install the downloaded system update</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.sekirokenjii.apex.update.discard">
    <description>Cancel the installation of a downloaded system update, or dismiss the warning about a failed one</description>
    <message>Authentication is required to cancel the system update or dismiss its warning</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.sekirokenjii.apex.update.rollback">
    <description>Go back to the previous system version</description>
    <message>Authentication is required to go back to the previous system version</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="io.github.sekirokenjii.apex.update.switch-channel">
    <description>Change the system update channel</description>
    <message>Authentication is required to change the system update channel</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="io.github.sekirokenjii.apex.update.downgrade">
    <description>Install an older system version</description>
    <message>Authentication is required to install an older system version</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
