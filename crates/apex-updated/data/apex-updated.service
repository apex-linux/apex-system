[Unit]
Description=Apex update service
Documentation=https://github.com/SekiroKenjii/apex-fedora/blob/main/docs/adr/0008-update-policy.md
RequiresMountsFor=/var/lib/apex /sysroot /boot

[Service]
Type=dbus
BusName=io.github.sekirokenjii.Apex.Update1
ExecStart=/usr/libexec/apex/apex-updated
# Readiness is still the bus name; this only admits the daemon's STATUS= lines.
NotifyAccess=main

StateDirectory=apex
StateDirectoryMode=0700
# grubenv too, when grub2-editenv replaces it: GRUB ignores the mode, and every other
# reader runs as root.
UMask=0077

# ProtectSystem=, SystemCallFilter=, NoNewPrivileges= and the rest tests/data_files.rs keeps out
# break bootc or the grubenv writer (`unshare --mount`, then `mount -o remount,rw /boot`).
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
# AF_NETLINK: glibc's resolver looks up local addresses over rtnetlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
# Also limits devices to the pseudo devices and the RTC: neither bootc on the ostree backend
# nor the /boot remount opens a block device.
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
