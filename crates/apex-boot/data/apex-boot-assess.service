[Unit]
Description=Apex boot assessment
Documentation=https://github.com/SekiroKenjii/apex-fedora/blob/main/docs/adr/0009-boot-assessment.md
ConditionPathExists=/run/ostree-booted
# No Before=: the assessment takes minutes and must never delay boot-complete.target or a login.
After=graphical.target
RequiresMountsFor=/boot /var/lib/apex

[Service]
Type=oneshot
ExecStart=/usr/libexec/apex/apex-boot-assess
RemainAfterExit=yes
TimeoutStartSec=360
Restart=no

ProtectSystem=strict
StateDirectory=apex
StateDirectoryMode=0700
UMask=0077
PrivateTmp=yes
ProtectHome=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX

CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictNamespaces=mnt
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Deliberately unset, as they break bootc, ostree, grub2-editenv or the audio check: PrivateIPC=,
# PrivateDevices=, DevicePolicy=, ProtectClock=, PrivateUsers=, ProcSubset=.

[Install]
WantedBy=graphical.target
