[Unit]
Description=Apex boot assessment
Documentation=https://github.com/SekiroKenjii/apex-fedora/blob/main/docs/adr/0009-boot-assessment.md
ConditionPathExists=/run/ostree-booted
# The binary waits for a greeter or user session itself: a session is not a unit state.
After=graphical.target
# No Before=boot-complete.target and nothing ordered after this unit: the assessment takes
# minutes and must never delay boot-complete.target, the greeter or a login.
RequiresMountsFor=/boot /var/lib/apex

[Service]
Type=oneshot
ExecStart=/usr/libexec/apex/apex-boot-assess
# One verdict per boot, also when graphical.target is reached again.
RemainAfterExit=yes
# At least apex_boot::ASSESS_TIME_BUDGET, or systemd could kill the assessment between its
# grubenv write and its report.
TimeoutStartSec=360
Restart=no

# No ReadWritePaths= for /boot: grubenv is written only in the writer's private mount
# namespace, and a writable bind mount would not help because /boot itself is read-only.
ProtectSystem=strict
StateDirectory=apex
StateDirectoryMode=0700
UMask=0077
# Required: bootc writes a temporary copy of itself to /tmp for its SELinux re-exec.
PrivateTmp=yes
ProtectHome=yes
# No PrivateIPC=: bootc then joins the host IPC namespace with setns, which
# RestrictNamespaces=mnt forbids, and `bootc status` fails.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX

# CAP_SYS_ADMIN: the grubenv writer's unshare and /boot remount, ostree's remounts for the
# sysroot lock, and bootc refuses to start without it. CAP_SYS_PTRACE: bootc reads
# /proc/1/ns/mnt, a ptrace access check once PID 1 holds capabilities this unit does not.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
# Also keeps bootc, mount and grub2-editenv in this unit's SELinux domain.
NoNewPrivileges=yes
# @mount for those remounts; EPERM so a helper meeting a refused call fails with a message
# instead of dying on SIGSYS.
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictNamespaces=mnt
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Not set on purpose: PrivateDevices=, DevicePolicy= and ProtectClock= close the block
# devices grub2-editenv, bootc and ostree probe; PrivateUsers= locks the inherited mounts
# read-only; ProcSubset=pid hides /proc/asound, which the audio check reads.

[Install]
WantedBy=graphical.target
